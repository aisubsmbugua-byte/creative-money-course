# Postgres connection string (Vercel Postgres / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/creative_money_course"

# NextAuth (used to sign/encrypt session JWTs)
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google service account used to proxy video/resource files out of Drive.
# See README for how to create this and share the Drive folder with it.
GOOGLE_SERVICE_ACCOUNT_EMAIL="xxxx@xxxx.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
