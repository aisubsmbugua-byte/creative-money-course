# Postgres connection string (Vercel Postgres / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/creative_money_course"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Email provider (magic link) — e.g. Resend, Postmark, or SMTP
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="Creative Money Course <noreply@kanjiimbugua.com>"

# Google service account used to proxy video/resource files out of Drive.
# See README for how to create this and share the Drive folder with it.
GOOGLE_SERVICE_ACCOUNT_EMAIL="xxxx@xxxx.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
