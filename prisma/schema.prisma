generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NextAuth required models ---

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  moduleProgress    ModuleProgress[]
  workbookResponses WorkbookResponse[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Course content ---

model Module {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  description  String?
  order        Int     @unique
  videoTitle   String?
  videoDriveId String?
  createdAt    DateTime @default(now())

  workbook  Workbook?
  progress  ModuleProgress[]
  resources ModuleResource[]
}

model ModuleResource {
  id          String @id @default(cuid())
  moduleId    String
  title       String
  driveFileId String

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Workbook {
  id       String @id @default(cuid())
  moduleId String @unique
  title    String

  module    Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions WorkbookQuestion[]
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  CHECKBOX
}

model WorkbookQuestion {
  id         String       @id @default(cuid())
  workbookId String
  order      Int
  prompt     String
  type       QuestionType @default(LONG_TEXT)
  required   Boolean      @default(true)

  workbook  Workbook           @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  responses WorkbookResponse[]

  @@unique([workbookId, order])
}

model WorkbookResponse {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  answer     String
  updatedAt  DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question WorkbookQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model ModuleProgress {
  id                  String    @id @default(cuid())
  userId              String
  moduleId            String
  videoWatchedAt      DateTime?
  workbookCompletedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}
