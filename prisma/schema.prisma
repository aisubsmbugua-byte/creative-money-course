generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  moduleProgress    ModuleProgress[]
  workbookResponses WorkbookResponse[]
}

// --- Course content ---

model Module {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  description  String?
  order        Int     @unique
  videoTitle   String?
  videoDriveId String?
  createdAt    DateTime @default(now())

  workbook  Workbook?
  progress  ModuleProgress[]
  resources ModuleResource[]
}

model ModuleResource {
  id          String @id @default(cuid())
  moduleId    String
  title       String
  driveFileId String

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Workbook {
  id       String @id @default(cuid())
  moduleId String @unique
  title    String

  module    Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions WorkbookQuestion[]
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  CHECKBOX
}

model WorkbookQuestion {
  id         String       @id @default(cuid())
  workbookId String
  order      Int
  prompt     String
  type       QuestionType @default(LONG_TEXT)
  required   Boolean      @default(true)

  workbook  Workbook           @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  responses WorkbookResponse[]

  @@unique([workbookId, order])
}

model WorkbookResponse {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  answer     String
  updatedAt  DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question WorkbookQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model ModuleProgress {
  id                  String    @id @default(cuid())
  userId              String
  moduleId            String
  videoWatchedAt      DateTime?
  videoPosition       Int       @default(0)
  workbookCompletedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}
